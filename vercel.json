{
  
  "functions": {
    
    "server/index.ts": { 
      "runtime": "@vercel/node@2.0.1",
      "memory": 1024,
      "maxDuration": 10
    }
  },
  
  
  "rewrites": [
    
    {
      "source": "/api/(.*)",
      "destination": "/server/index.ts" 
    },
    
    {
      "source": "/(.*)",
      "destination": "/client/$1"
    }
  ]
}