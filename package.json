{
  "name": "mpms-root",
  "version": "1.0.0",
  "description": "MPMS Project Root Scripts",
  "scripts": {
    "start": "concurrently \"npm run server\" \"npm run client\"",
    "server": "cd server && npm run dev",
    "client": "cd client && npm run dev",
    "install:all": "cd server && npm install && cd client && npm install",
    "seed": "cd server && npx ts-node src/seeder.ts",
    "seed:destroy": "cd server && npx ts-node src/seeder.ts -d"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "author": "Salim Shadman",
  "license": "ISC"
}